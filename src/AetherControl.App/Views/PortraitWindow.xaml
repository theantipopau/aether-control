<Window
    x:Class="AetherControl.App.Views.PortraitWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AetherControl.App.Controls"
    xmlns:converters="using:AetherControl.App.Converters">

    <Grid x:Name="RootGrid" Background="{StaticResource PortraitPageBgBrush}">
        <Grid.Resources>
            <converters:OneDecimalPercentConverter x:Key="OneDecimalPercentConverter" />
        </Grid.Resources>

        <ScrollViewer Padding="16,20,16,16">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    Header. DragRegion (name + clock, no interactive controls) is what
                    Window.SetTitleBar() points at in code-behind — the same proven mechanism
                    MainWindow already uses successfully, rather than a hand-rolled
                    GetCursorPos/AppWindow.Move drag that turned out not to actually work. The
                    Pin/OLED/Fill buttons are deliberately siblings OUTSIDE that element: WinUI3
                    doesn't auto-passthrough clicks to controls placed *inside* a SetTitleBar
                    region (that needs InputNonClientPointerSource region rects), so keeping them
                    outside is what lets them stay normally clickable with zero extra plumbing.
                    The native Close button (now shown, since the border/title-bar are no longer
                    fully stripped) is intercepted in code-behind to Hide rather than destroy the
                    window, same as the old custom ✕ button used to.
                -->
                <Grid x:Name="HeaderGrid" Grid.Row="0" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="DragRegion" Grid.Column="0" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SYSTEM MONITOR" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource PortraitTextMutedBrush}" />
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,14,0">
                            <TextBlock Text="{x:Bind ViewModel.CurrentTimeText, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas"
                                       FontSize="18" FontWeight="Bold" Foreground="{StaticResource PortraitTextPrimaryBrush}" HorizontalAlignment="Right" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentDateText, Mode=OneWay}" FontSize="11"
                                       Foreground="{StaticResource PortraitTextSecondaryBrush}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                    <ToggleButton x:Name="AlwaysOnTopToggle" Grid.Column="1" Content="PIN" FontSize="10" FontWeight="SemiBold" Width="44"
                                  Style="{StaticResource PortraitHeaderIconButtonStyle}" Margin="0,0,8,0"
                                  Checked="OnAlwaysOnTopChanged" Unchecked="OnAlwaysOnTopChanged" ToolTipService.ToolTip="Always on top" />
                    <ToggleButton x:Name="OledToggle" Grid.Column="2" Content="OLED" FontSize="10" FontWeight="SemiBold" Width="44"
                                  Style="{StaticResource PortraitHeaderIconButtonStyle}" Margin="0,0,8,0"
                                  Checked="OnOledToggleChanged" Unchecked="OnOledToggleChanged" ToolTipService.ToolTip="Pure black (OLED)" />
                    <ToggleButton x:Name="FillScreenToggle" Grid.Column="3" Content="FILL" FontSize="10" FontWeight="SemiBold" Width="44"
                                  Style="{StaticResource PortraitHeaderIconButtonStyle}"
                                  Checked="OnFillScreenChecked" Unchecked="OnFillScreenUnchecked"
                                  ToolTipService.ToolTip="Fill whichever monitor this window is currently on — drag it onto your portrait monitor first, then toggle this. Toggle again to restore." />
                </Grid>

                <!-- CPU -->
                <StackPanel Grid.Row="1" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="4" Height="14" CornerRadius="2" Background="{StaticResource PortraitCpuAccentBrush}" />
                        <TextBlock Text="CPU" Style="{StaticResource PortraitSectionHeaderText}" />
                        <controls:PortraitVendorBadge Vendor="{x:Bind ViewModel.CpuVendor, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.CpuName, Mode=OneWay}" FontSize="11" Foreground="{StaticResource PortraitTextMutedBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border Style="{StaticResource PortraitCardBorderStyle}" Height="132">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="26" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="USAGE" Style="{StaticResource PortraitCaptionLabelText}" />
                                    <TextBlock Text="{x:Bind ViewModel.CpuUsageText, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas"
                                               FontSize="32" FontWeight="Bold" Foreground="{StaticResource PortraitCpuAccentBrush}" />
                                </StackPanel>
                                <controls:PortraitRing Value="{x:Bind ViewModel.CpuUsagePercent, Mode=OneWay}"
                                                        Stroke="{StaticResource PortraitCpuAccentBrush}"
                                                        Width="66" Height="66" RingThickness="7"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" />
                            </Grid>
                            <controls:PortraitSparkline Grid.Row="1" Values="{x:Bind ViewModel.CpuUsageHistory, Mode=OneWay}"
                                                         Stroke="{StaticResource PortraitCpuAccentBrush}" />
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:PortraitMetricTile Grid.Column="0" Title="TEMP" Value="{x:Bind ViewModel.CpuTempText, Mode=OneWay}"
                                                      Severity="{x:Bind ViewModel.CpuTempSeverity, Mode=OneWay}" HasBar="False" />
                        <controls:PortraitMetricTile Grid.Column="1" Title="CORE CLOCK" Value="{x:Bind ViewModel.CpuClockText, Mode=OneWay}"
                                                      Accent="{StaticResource PortraitCpuAccentBrush}" HasBar="False" />
                        <controls:PortraitMetricTile Grid.Column="2" Title="POWER" Value="{x:Bind ViewModel.CpuPowerText, Mode=OneWay}"
                                                      Accent="{StaticResource PortraitCpuAccentBrush}" HasBar="False" />
                    </Grid>
                </StackPanel>

                <!-- GPU -->
                <StackPanel Grid.Row="2" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="4" Height="14" CornerRadius="2" Background="{StaticResource PortraitGpuAccentBrush}" />
                        <TextBlock Text="GPU" Style="{StaticResource PortraitSectionHeaderText}" />
                        <controls:PortraitVendorBadge Vendor="{x:Bind ViewModel.GpuVendor, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.GpuName, Mode=OneWay}" FontSize="11" Foreground="{StaticResource PortraitTextMutedBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border Style="{StaticResource PortraitCardBorderStyle}" Height="132">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="26" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="USAGE" Style="{StaticResource PortraitCaptionLabelText}" />
                                    <TextBlock Text="{x:Bind ViewModel.GpuUsageText, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas"
                                               FontSize="32" FontWeight="Bold" Foreground="{StaticResource PortraitGpuAccentBrush}" />
                                </StackPanel>
                                <controls:PortraitRing Value="{x:Bind ViewModel.GpuUsagePercent, Mode=OneWay}"
                                                        Stroke="{StaticResource PortraitGpuAccentBrush}"
                                                        Width="66" Height="66" RingThickness="7"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" />
                            </Grid>
                            <controls:PortraitSparkline Grid.Row="1" Values="{x:Bind ViewModel.GpuUsageHistory, Mode=OneWay}"
                                                         Stroke="{StaticResource PortraitGpuAccentBrush}" />
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:PortraitMetricTile Grid.Column="0" Title="TEMP" Value="{x:Bind ViewModel.GpuTempText, Mode=OneWay}"
                                                      Severity="{x:Bind ViewModel.GpuTempSeverity, Mode=OneWay}" HasBar="False" />
                        <controls:PortraitMetricTile Grid.Column="1" Title="HOTSPOT" Value="{x:Bind ViewModel.GpuHotspotText, Mode=OneWay}"
                                                      Severity="{x:Bind ViewModel.GpuHotspotSeverity, Mode=OneWay}" HasBar="False" />
                        <controls:PortraitMetricTile Grid.Column="2" Title="FAN" Value="{x:Bind ViewModel.GpuFanText, Mode=OneWay}"
                                                      Accent="{StaticResource PortraitGpuAccentBrush}" HasBar="False" />
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:PortraitMetricTile Grid.Column="0" Title="WATTAGE" Value="{x:Bind ViewModel.GpuWattageText, Mode=OneWay}"
                                                      Accent="{StaticResource PortraitGpuAccentBrush}" HasBar="False" />
                        <controls:PortraitMetricTile Grid.Column="1" Title="CORE CLOCK" Value="{x:Bind ViewModel.GpuCoreClockText, Mode=OneWay}"
                                                      Accent="{StaticResource PortraitGpuAccentBrush}" HasBar="False" />
                        <controls:PortraitMetricTile Grid.Column="2" Title="MEM CLOCK" Value="{x:Bind ViewModel.GpuMemClockText, Mode=OneWay}"
                                                      Accent="{StaticResource PortraitGpuAccentBrush}" HasBar="False" />
                    </Grid>

                    <controls:PortraitMetricTile Title="VRAM" Value="{x:Bind ViewModel.VramUsedText, Mode=OneWay}"
                                                  Percent="{x:Bind ViewModel.VramPercent, Mode=OneWay}" Accent="{StaticResource PortraitGpuAccentBrush}" />
                </StackPanel>

                <!-- Fans -->
                <StackPanel Grid.Row="3" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="4" Height="14" CornerRadius="2" Background="{StaticResource PortraitDriveAccentBrush}" />
                        <TextBlock Text="FANS" Style="{StaticResource PortraitSectionHeaderText}" />
                        <TextBlock Text="unlabeled by the board — click a name to rename it" FontSize="11"
                                   Foreground="{StaticResource PortraitTextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border Style="{StaticResource PortraitCardBorderStyle}" Padding="14,8">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Fans, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding DisplayName, Mode=OneWay}" Background="Transparent"
                                                 BorderThickness="0,0,0,1" BorderBrush="{StaticResource PortraitCardBorderBrush}"
                                                 Foreground="{StaticResource PortraitTextPrimaryBrush}" FontSize="13" Padding="2"
                                                 LostFocus="OnFanNameLostFocus"
                                                 ToolTipService.ToolTip="Click to rename — e.g. once you've worked out which one is the CPU fan" />
                                        <TextBlock Grid.Column="1" Text="{Binding RpmText}" FontFamily="Cascadia Mono, Consolas"
                                                   Foreground="{StaticResource PortraitDriveAccentBrush}" FontSize="13" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- RAM / Drive -->
                <Grid Grid.Row="4" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:PortraitMetricTile Grid.Column="0" Title="RAM" Value="{x:Bind ViewModel.RamUsedText, Mode=OneWay}"
                                                  Percent="{x:Bind ViewModel.RamPercent, Mode=OneWay}" Severity="{x:Bind ViewModel.RamSeverity, Mode=OneWay}"
                                                  Accent="{StaticResource PortraitRamAccentBrush}" />
                    <controls:PortraitMetricTile Grid.Column="1" Title="DRIVE TEMP" Value="{x:Bind ViewModel.DriveTempText, Mode=OneWay}"
                                                  Severity="{x:Bind ViewModel.DriveTempSeverity, Mode=OneWay}" HasBar="False" />
                </Grid>

                <!-- FPS — the one number people actually glance at mid-game. -->
                <controls:PortraitMetricTile Grid.Row="5" Title="FPS" Value="{x:Bind ViewModel.FpsText, Mode=OneWay}"
                                              Accent="{StaticResource PortraitFpsAccentBrush}" HasBar="False" />

                <!-- Top processes -->
                <StackPanel Grid.Row="6" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="4" Height="14" CornerRadius="2" Background="{StaticResource PortraitProcessAccentBrush}" />
                        <TextBlock Text="PROCESSES" Style="{StaticResource PortraitSectionHeaderText}" />
                    </StackPanel>

                    <Border Style="{StaticResource PortraitCardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TOP CPU" Style="{StaticResource PortraitCaptionLabelText}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.TopCpuProcesses, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource PortraitTextPrimaryBrush}"
                                                           FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding CpuPercent, Converter={StaticResource OneDecimalPercentConverter}}"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           Foreground="{StaticResource PortraitCpuAccentBrush}" FontSize="13" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="TOP GPU" Style="{StaticResource PortraitCaptionLabelText}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.TopGpuProcesses, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource PortraitTextPrimaryBrush}"
                                                           FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding GpuPercent, Converter={StaticResource OneDecimalPercentConverter}}"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           Foreground="{StaticResource PortraitGpuAccentBrush}" FontSize="13" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
