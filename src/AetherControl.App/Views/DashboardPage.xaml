<Page
    x:Class="AetherControl.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AetherControl.App.Controls"
    xmlns:converters="using:AetherControl.App.Converters"
    xmlns:local="using:AetherControl.App.Views"
    Background="{StaticResource AetherBackgroundTranslucentBrush}">

    <Page.Resources>
        <converters:SeverityToneConverter x:Key="SeverityToneConverter" />
        <converters:DriveHealthToneConverter x:Key="DriveHealthToneConverter" />
        <converters:CollectionEmptyToVisibilityConverter x:Key="CollectionEmptyToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:PercentDisplayConverter x:Key="PercentDisplayConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:HealthLevelToBrushConverter x:Key="HealthLevelToBrushConverter" />
        <converters:HealthLevelToGlyphConverter x:Key="HealthLevelToGlyphConverter" />

        <!-- Every MetricCard on this page gets consistent spacing automatically — no per-instance Margin repeated 25 times. -->
        <Style TargetType="controls:MetricCard">
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="24">
        <Grid x:Name="RootGrid" ColumnSpacing="32" RowSpacing="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumnDef" Width="*" />
                <ColumnDefinition x:Name="RightColumnDef" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                Overview hero (ROADMAP 39.4): the one panel that answers "is my PC OK right now?".
                Left: verdict (glyph + words, never colour alone) + quick actions. Right: the three
                readings people glance for, larger than the old strip of five small gauges.
                Values bind to the same ViewModel properties as before — no extra polling.
            -->
            <Border x:Name="HeroPanel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource HeroBorderStyle}">
                <Grid x:Name="HeroGrid" ColumnSpacing="{StaticResource Space32}" RowSpacing="{StaticResource Space24}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="HeroStatusColumn" Width="*" MinWidth="360" />
                        <ColumnDefinition x:Name="HeroTrendsColumn" Width="*" />
                        <ColumnDefinition x:Name="HeroGaugeColumn" Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Spacing="{StaticResource Space16}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space12}"
                                    AutomationProperties.LiveSetting="Polite"
                                    AutomationProperties.Name="{x:Bind ViewModel.HealthTitle, Mode=OneWay}">
                            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource SurfaceElevatedBrush}"
                                    BorderThickness="1" BorderBrush="{x:Bind ViewModel.HealthLevel, Mode=OneWay, Converter={StaticResource HealthLevelToBrushConverter}}">
                                <FontIcon FontSize="18"
                                          Glyph="{x:Bind ViewModel.HealthLevel, Mode=OneWay, Converter={StaticResource HealthLevelToGlyphConverter}}"
                                          Foreground="{x:Bind ViewModel.HealthLevel, Mode=OneWay, Converter={StaticResource HealthLevelToBrushConverter}}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="SYSTEM STATUS" Style="{StaticResource LabelTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.HealthTitle, Mode=OneWay}" FontSize="26" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.HealthDetail, Mode=OneWay}" Style="{StaticResource PageSubtitleTextStyle}" MaxWidth="560" HorizontalAlignment="Left" />

                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis">
                                <Run Text="{x:Bind ViewModel.CpuName, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{x:Bind ViewModel.GpuName, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{x:Bind ViewModel.MotherboardModel, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>

                        <!-- Quick actions: navigation only — each one goes somewhere real and claims nothing. -->
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                            <Button Click="OnOpenPortraitClick" ToolTipService.ToolTip="Open Portrait Mode on the portrait display">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                                    <TextBlock Text="Portrait Mode" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnOpenPerformanceClick" ToolTipService.ToolTip="Optimisation, cooling, startup and game profiles">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                                    <FontIcon Glyph="&#xEC4A;" FontSize="14" />
                                    <TextBlock Text="Performance" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnOpenLightingClick" ToolTipService.ToolTip="RGB devices and scenes">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                                    <FontIcon Glyph="&#xE790;" FontSize="14" />
                                    <TextBlock Text="Lighting" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Trend sparklines live in the hero: on wide windows this filled the gap between
                         verdict and gauges, and it freed a whole row in the left column. -->
                    <StackPanel x:Name="HeroTrends" Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="LAST MINUTE" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Text="CPU/GPU load — shows whether a number that jumped was a real spike or just noise."
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource InsetBorderStyle}" Padding="12,10">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="CPU LOAD" Style="{StaticResource LabelTextStyle}" />
                                    <TextBlock FontSize="11" Typography.NumeralAlignment="Tabular" Foreground="{StaticResource AetherAccentBrush}">
                                        <Run Text="{x:Bind ViewModel.CpuUtilisation, Mode=OneWay, Converter={StaticResource PercentDisplayConverter}}" /><Run Text="%" />
                                    </TextBlock>
                                </StackPanel>
                                <controls:PortraitSparkline Height="64" Values="{x:Bind ViewModel.CpuUsageHistory, Mode=OneWay}" Stroke="{StaticResource AetherAccentBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource InsetBorderStyle}" Padding="12,10">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="GPU LOAD" Style="{StaticResource LabelTextStyle}" />
                                    <TextBlock FontSize="11" Typography.NumeralAlignment="Tabular" Foreground="{StaticResource AetherAccentBrush}">
                                        <Run Text="{x:Bind ViewModel.GpuUtilisation, Mode=OneWay, Converter={StaticResource PercentDisplayConverter}}" /><Run Text="%" />
                                    </TextBlock>
                                </StackPanel>
                                <controls:PortraitSparkline Height="64" Values="{x:Bind ViewModel.GpuUsageHistory, Mode=OneWay}" Stroke="{StaticResource AetherAccentBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                    <!-- Scaled via Viewbox rather than a new size property on RadialGauge: same control,
                         same tween, just drawn larger. -->
                    <StackPanel x:Name="HeroGauges" Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource Space24}" VerticalAlignment="Center">
                        <StackPanel Spacing="{StaticResource Space8}">
                            <Viewbox Width="148">
                                <controls:RadialGauge Label="CPU" Unit="°C" Max="100"
                                    Value="{x:Bind ViewModel.CpuTemperature, Mode=OneWay}"
                                    Tone="{x:Bind ViewModel.CpuTemperature, Mode=OneWay, Converter={StaticResource SeverityToneConverter}, ConverterParameter=temperature}"
                                    AutomationProperties.Name="CPU temperature" />
                            </Viewbox>
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Typography.NumeralAlignment="Tabular">
                                <Run Text="{x:Bind ViewModel.CpuUtilisation, Mode=OneWay, Converter={StaticResource PercentDisplayConverter}}" /><Run Text="% load" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Spacing="{StaticResource Space8}">
                            <Viewbox Width="148">
                                <controls:RadialGauge Label="GPU" Unit="°C" Max="100"
                                    Value="{x:Bind ViewModel.GpuTemperature, Mode=OneWay}"
                                    Tone="{x:Bind ViewModel.GpuTemperature, Mode=OneWay, Converter={StaticResource SeverityToneConverter}, ConverterParameter=temperature}"
                                    AutomationProperties.Name="GPU temperature" />
                            </Viewbox>
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Typography.NumeralAlignment="Tabular">
                                <Run Text="{x:Bind ViewModel.GpuUtilisation, Mode=OneWay, Converter={StaticResource PercentDisplayConverter}}" /><Run Text="% load" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Spacing="{StaticResource Space8}">
                            <Viewbox Width="148">
                                <controls:RadialGauge Label="MEMORY" Unit="%" Max="100"
                                    Value="{x:Bind ViewModel.RamUtilisationPercent, Mode=OneWay}"
                                    Tone="{x:Bind ViewModel.RamUtilisationPercent, Mode=OneWay, Converter={StaticResource SeverityToneConverter}, ConverterParameter=usage}"
                                    AutomationProperties.Name="Memory used" />
                            </Viewbox>
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Typography.NumeralAlignment="Tabular">
                                <Run Text="{x:Bind local:DashboardPage.FormatOneDecimal(ViewModel.RamUsedGb), Mode=OneWay}" /><Run Text=" GB used" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <!--
                Left column: CPU/GPU/Memory. Right column: Storage/Motherboard/Network. On a wide
                window they sit side by side (RootGrid's VisualStateManager below); below ~1100px
                RightColumnPanel drops to Row 2 under the left column instead of squeezing into a
                column too narrow for its cards to wrap sensibly.
            -->
            <StackPanel x:Name="LeftColumnPanel" Grid.Row="1" Grid.Column="0" Spacing="28">
                

                <StackPanel Spacing="10">
                    <controls:SectionHeader Label="CPU" />
                    <TextBlock Text="{x:Bind ViewModel.CpuName, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="164" ItemHeight="106">
                        <controls:MetricCard Label="TEMPERATURE" NumericValue="{x:Bind ViewModel.CpuTemperature, Mode=OneWay}" Format="F0" Unit="°C"
                                              Progress="{x:Bind ViewModel.CpuTemperature, Mode=OneWay}"
                                              Tone="{x:Bind ViewModel.CpuTemperature, Mode=OneWay, Converter={StaticResource SeverityToneConverter}, ConverterParameter=temperature}" />
                        <controls:MetricCard Label="PACKAGE POWER" NumericValue="{x:Bind ViewModel.CpuPackagePower, Mode=OneWay}" Format="F0" Unit="W" />
                        <controls:MetricCard Label="UTILISATION" NumericValue="{x:Bind ViewModel.CpuUtilisation, Mode=OneWay}" Format="F0" Unit="%"
                                              Progress="{x:Bind ViewModel.CpuUtilisation, Mode=OneWay}"
                                              Tone="{x:Bind ViewModel.CpuUtilisation, Mode=OneWay, Converter={StaticResource SeverityToneConverter}, ConverterParameter=usage}" />
                        <controls:MetricCard Label="CLOCK SPEED" NumericValue="{x:Bind ViewModel.CpuClockSpeed, Mode=OneWay}" Format="F0" Unit="MHz" />
                        <controls:MetricCard Label="VOLTAGE" NumericValue="{x:Bind ViewModel.CpuVoltage, Mode=OneWay}" Format="F2" Unit="V"
                                              Visibility="{x:Bind ViewModel.HasCpuVoltage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </VariableSizedWrapGrid>
                </StackPanel>

                <StackPanel Spacing="10">
                    <controls:SectionHeader Label="GPU" />
                    <TextBlock Text="{x:Bind ViewModel.GpuName, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="164" ItemHeight="106">
                        <controls:MetricCard Label="HOTSPOT" NumericValue="{x:Bind ViewModel.GpuHotspotTemperature, Mode=OneWay}" Format="F0" Unit="°C"
                                              Progress="{x:Bind ViewModel.GpuHotspotTemperature, Mode=OneWay}"
                                              Tone="{x:Bind ViewModel.GpuHotspotTemperature, Mode=OneWay, Converter={StaticResource SeverityToneConverter}, ConverterParameter=temperature}" />
                        <controls:MetricCard Label="POWER DRAW" NumericValue="{x:Bind ViewModel.GpuPowerDraw, Mode=OneWay}" Format="F0" Unit="W" />
                        <controls:MetricCard Label="VRAM USED" NumericValue="{x:Bind ViewModel.GpuVramUsedMb, Mode=OneWay}" Format="F0" Unit="MB" />
                        <controls:MetricCard Label="FAN SPEED" NumericValue="{x:Bind ViewModel.GpuFanSpeedPercent, Mode=OneWay}" Format="F0" Unit="%"
                                              Detail="{x:Bind local:DashboardPage.FormatGpuFanDetail(ViewModel.GpuFanSpeedPercent, ViewModel.GpuTemperature), Mode=OneWay}"
                                              Progress="{x:Bind ViewModel.GpuFanSpeedPercent, Mode=OneWay}" />
                    </VariableSizedWrapGrid>
                </StackPanel>

                <StackPanel Spacing="10">
                    <controls:SectionHeader Label="Memory" />
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="164" ItemHeight="106">
                        <controls:MetricCard Label="USED" NumericValue="{x:Bind ViewModel.RamUsedGb, Mode=OneWay}" Format="F1" Unit="GB" />
                        <controls:MetricCard Label="AVAILABLE" NumericValue="{x:Bind ViewModel.RamAvailableGb, Mode=OneWay}" Format="F1" Unit="GB" />
                        <controls:MetricCard Label="UTILISATION" NumericValue="{x:Bind ViewModel.RamUtilisationPercent, Mode=OneWay}" Format="F0" Unit="%"
                                              Progress="{x:Bind ViewModel.RamUtilisationPercent, Mode=OneWay}"
                                              Tone="{x:Bind ViewModel.RamUtilisationPercent, Mode=OneWay, Converter={StaticResource SeverityToneConverter}, ConverterParameter=usage}" />
                        <controls:MetricCard Label="SPEED" NumericValue="{x:Bind ViewModel.RamSpeedMhz, Mode=OneWay}" Format="F0" Unit="MHz" />
                    </VariableSizedWrapGrid>
                </StackPanel>

                
            </StackPanel>

            <StackPanel x:Name="RightColumnPanel" Grid.Row="1" Grid.Column="1" Spacing="28">
                <StackPanel Spacing="10">
                    <controls:SectionHeader Label="Storage" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Drives, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="224" ItemHeight="128" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:MetricCard
                                    CardWidth="208"
                                    Label="{Binding Model}"
                                    NumericValue="{Binding FreeGb}" Format="F0" Unit="GB free"
                                    Detail="{Binding DetailText}"
                                    Progress="{Binding UsedPercent}"
                                    Tone="{Binding Health, Converter={StaticResource DriveHealthToneConverter}}"
                                    DiagnosticTag="{Binding DeviceId}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="10">
                    <controls:SectionHeader Label="Motherboard" />
                    <TextBlock Text="{x:Bind ViewModel.MotherboardModel, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                    <!-- Glyph + text, not colour alone. Collapses entirely while readings are live. -->
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}"
                                Visibility="{x:Bind ViewModel.MotherboardStaleText, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{StaticResource StatusWarningBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.MotherboardStaleText, Mode=OneWay}" Style="{StaticResource StatusTextStyle}"
                                   Foreground="{StaticResource StatusWarningBrush}" />
                    </StackPanel>

                    <!-- Raw Super I/O channels (unlabelled "Voltage #11", empty fan headers, board
                         probes): accurate but dense. Collapsed by default so the Overview leads with
                         what matters; nothing is hidden or filtered once expanded. -->
                    <Expander Header="Sensor detail — voltages, board temperatures, fan headers" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" IsExpanded="False">
                        <StackPanel Spacing="10">
                    <TextBlock Text="Voltages" Style="{StaticResource SubsectionLabelTextStyle}" />
                    <Border Style="{StaticResource CardBorderStyle}" Padding="12"
                            Visibility="{x:Bind ViewModel.MotherboardVoltages.Count, Mode=OneWay, Converter={StaticResource CollectionEmptyToVisibilityConverter}}">
                        <TextBlock Text="No voltage sensors reported by this board yet." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    </Border>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.MotherboardVoltages, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="164" ItemHeight="106" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:MetricCard Label="{Binding Name}" NumericValue="{Binding Value}" Format="F2" Unit="{Binding Unit}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Board Temperatures" Style="{StaticResource SubsectionLabelTextStyle}" Margin="0,8,0,0" />
                    <Border Style="{StaticResource CardBorderStyle}" Padding="12"
                            Visibility="{x:Bind ViewModel.MotherboardVrmTemperatures.Count, Mode=OneWay, Converter={StaticResource CollectionEmptyToVisibilityConverter}}">
                        <TextBlock Text="No board temperature sensors reported by this Super I/O chip." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    </Border>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.MotherboardVrmTemperatures, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="164" ItemHeight="106" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:MetricCard Label="{Binding Name}" NumericValue="{Binding Value}" Format="F0" Unit="{Binding Unit}"
                                                      Tone="{Binding Value, Converter={StaticResource SeverityToneConverter}, ConverterParameter=temperature}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Fan Speeds" Style="{StaticResource SubsectionLabelTextStyle}" Margin="0,8,0,0" />
                    <Border Style="{StaticResource CardBorderStyle}" Padding="12" MaxWidth="480" HorizontalAlignment="Left"
                            Visibility="{x:Bind ViewModel.MotherboardFanSpeeds.Count, Mode=OneWay, Converter={StaticResource CollectionEmptyToVisibilityConverter}}">
                        <TextBlock Text="No fan RPM available right now — if ASUS Armoury Crate (or another vendor fan-control service) is running, it may be holding exclusive access to the Super I/O sensors."
                                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    </Border>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.MotherboardFanSpeeds, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="164" ItemHeight="106" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:MetricCard Label="{Binding Name}" NumericValue="{Binding Value}" Format="F0" Unit="{Binding Unit}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <StackPanel Spacing="10">
                    <controls:SectionHeader Label="Network" />
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="164" ItemHeight="106">
                        <controls:MetricCard Label="UPLOAD" NumericValue="{x:Bind ViewModel.NetworkUploadMbps, Mode=OneWay}" Format="F1" Unit="Mbps" />
                        <controls:MetricCard Label="DOWNLOAD" NumericValue="{x:Bind ViewModel.NetworkDownloadMbps, Mode=OneWay}" Format="F1" Unit="Mbps" />
                        <controls:MetricCard Label="LATENCY" NumericValue="{x:Bind ViewModel.NetworkLatencyMs, Mode=OneWay}" Format="F0" Unit="ms" />
                        <controls:MetricCard Label="EXTERNAL IP" Value="{x:Bind ViewModel.NetworkExternalIpDisplay, Mode=OneWay}"
                                              Detail="Click to show / hide" Tapped="OnExternalIpTapped"
                                              ToolTipService.ToolTip="Hidden by default so it doesn't end up in screenshots" />
                    </VariableSizedWrapGrid>
                </StackPanel>

                <!-- Ported from Portrait Stats' ProcessRankerService — "what's actually using the
                     CPU right now", the same question Task Manager's Processes tab answers. -->
                <StackPanel Spacing="10">
                    <controls:SectionHeader Label="Top Processes" />
                    <Border Style="{StaticResource CardBorderStyle}" Padding="12"
                            Visibility="{x:Bind ViewModel.TopProcessesByCpu.Count, Mode=OneWay, Converter={StaticResource CollectionEmptyToVisibilityConverter}}">
                        <TextBlock Text="Nothing using meaningful CPU right now." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    </Border>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.TopProcessesByCpu, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="164" ItemHeight="106" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:MetricCard Label="{Binding Name}" NumericValue="{Binding CpuPercent}" Format="F1" Unit="%"
                                                      Progress="{Binding CpuPercent}"
                                                      Tone="{Binding CpuPercent, Converter={StaticResource SeverityToneConverter}, ConverterParameter=usage}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1180" />
                        </VisualState.StateTriggers>
                        <!-- Default markup above already IS the wide (two-column) layout — nothing to override here. -->
                    </VisualState>
                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="RightColumnDef.Width" Value="0" />
                            <Setter Target="RightColumnPanel.(Grid.Row)" Value="2" />
                            <Setter Target="RightColumnPanel.(Grid.Column)" Value="0" />
                            <Setter Target="HeroGauges.(Grid.Row)" Value="1" />
                            <Setter Target="HeroGauges.(Grid.Column)" Value="0" />
                            <Setter Target="HeroGaugeColumn.Width" Value="0" />
                            <Setter Target="HeroTrendsColumn.Width" Value="0" />
                            <Setter Target="HeroStatusColumn.MinWidth" Value="0" />
                            <Setter Target="HeroTrends.(Grid.Row)" Value="2" />
                            <Setter Target="HeroTrends.(Grid.Column)" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ScrollViewer>
</Page>
