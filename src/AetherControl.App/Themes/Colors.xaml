<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Aether Control's whole visual identity is: dark charcoal ground, white primary text,
        muted grey secondary text, and exactly one accent colour (swappable in Settings — see
        AccentColor enum). No gradients, no per-vendor RGB theming of the UI itself.
    -->
    <Color x:Key="AetherBackgroundColor">#0F1113</Color>
    <!-- Same charcoal, ~72% opacity: lets the MainWindow's Mica backdrop show through as a
         subtle texture/parallax behind page content instead of hiding it completely. -->
    <Color x:Key="AetherBackgroundTranslucentColor">#B80F1113</Color>
    <Color x:Key="AetherSurfaceColor">#1A1D1F</Color>
    <Color x:Key="AetherSurfaceRaisedColor">#232629</Color>
    <Color x:Key="AetherBorderColor">#2C3033</Color>
    <Color x:Key="AetherTextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="AetherTextSecondaryColor">#9BA1A6</Color>
    <Color x:Key="AetherAccentColor">#00E5FF</Color>

    <!-- Severity tones (temperature/usage thresholds) — deliberately fixed, not swappable with the
         accent colour: a "hot" reading should always read as a warning regardless of theme choice. -->
    <Color x:Key="AetherWarmColor">#F5C86B</Color>
    <Color x:Key="AetherHotColor">#FF6D6D</Color>

    <!-- Opaque — used by Portrait Mode, which is a dedicated always-on display and must never
         let the desktop show through (defeats OLED mode, looks broken on a second monitor). -->
    <SolidColorBrush x:Key="AetherBackgroundBrush" Color="{StaticResource AetherBackgroundColor}" />
    <!-- Translucent — used by the main app shell's pages, layered over the Mica backdrop. -->
    <SolidColorBrush x:Key="AetherBackgroundTranslucentBrush" Color="{StaticResource AetherBackgroundTranslucentColor}" />
    <SolidColorBrush x:Key="AetherSurfaceBrush" Color="{StaticResource AetherSurfaceColor}" />
    <SolidColorBrush x:Key="AetherSurfaceRaisedBrush" Color="{StaticResource AetherSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="AetherBorderBrush" Color="{StaticResource AetherBorderColor}" />
    <SolidColorBrush x:Key="AetherTextPrimaryBrush" Color="{StaticResource AetherTextPrimaryColor}" />
    <SolidColorBrush x:Key="AetherTextSecondaryBrush" Color="{StaticResource AetherTextSecondaryColor}" />
    <SolidColorBrush x:Key="AetherAccentBrush" Color="{StaticResource AetherAccentColor}" />
    <SolidColorBrush x:Key="AetherWarmBrush" Color="{StaticResource AetherWarmColor}" />
    <SolidColorBrush x:Key="AetherHotBrush" Color="{StaticResource AetherHotColor}" />

    <!--
        WinUI3's Fluent theme derives NavigationView's selection pill, ToggleSwitch's "on" fill,
        CheckBox/RadioButton's checked state, Slider, HyperlinkButton, and AccentButtonStyle all
        from SystemAccentColor (+ its Light1-3/Dark1-3 tints) — not from any of the AetherAccent*
        resources above. Left alone, every one of those controls shows Windows' OS-level accent
        colour instead of Aether Control's own, so the side nav's selected-item highlight (and
        every switch/checkbox in Settings) visually disagrees with the rest of the app. Overriding
        the whole SystemAccentColor family here — with the exact same tint/shade ratios Windows
        itself derives from a base colour — makes every stock control pick up AetherAccentColor
        automatically, with zero per-control restyling.
        TODO: when Settings' Accent picker actually applies at runtime (not yet wired), it needs
        to update this whole block, not just AetherAccentColor.
    -->
    <Color x:Key="SystemAccentColor">#00E5FF</Color>
    <Color x:Key="SystemAccentColorLight1">#40E9FF</Color>
    <Color x:Key="SystemAccentColorLight2">#80EFFF</Color>
    <Color x:Key="SystemAccentColorLight3">#BFF7FF</Color>
    <Color x:Key="SystemAccentColorDark1">#00B8CC</Color>
    <Color x:Key="SystemAccentColorDark2">#008C99</Color>
    <Color x:Key="SystemAccentColorDark3">#006066</Color>

</ResourceDictionary>
