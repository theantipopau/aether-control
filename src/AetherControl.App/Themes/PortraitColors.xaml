<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <!--
        Portrait Mode's palette now aliases Aether Control's own shared design tokens (Colors.xaml)
        instead of a separate near-duplicate one. It used to be a deliberately distinct multi-accent
        design (CPU/GPU/RAM/FPS/Drive each with their own hue) ported straight from the standalone
        Portrait Stats app; per instruction it now matches the main app's single-accent identity —
        every one of the brush keys below still exists (so PortraitWindow/PortraitMetricTile/etc.
        need no changes) but now resolves to the same charcoal/white/grey/cyan values used
        everywhere else in Aether Control, so Portrait Mode reads as the same product rather than a
        reskinned import. Severity tones are aliased to the same fixed (non-swappable) Warm/Hot
        colours the dashboard uses, for the same reason: a "hot" reading should look the same
        everywhere. Brand badge colours (Amd/Nvidia/Intel) are left alone — those are vendor logo
        colours, not theme.
    -->
    <SolidColorBrush x:Key="PortraitPageBgBrush" Color="{StaticResource AetherBackgroundColor}" />
    <SolidColorBrush x:Key="PortraitCardBgBrush" Color="{StaticResource AetherSurfaceColor}" />
    <SolidColorBrush x:Key="PortraitCardBorderBrush" Color="{StaticResource AetherBorderColor}" />

    <SolidColorBrush x:Key="PortraitTextPrimaryBrush" Color="{StaticResource AetherTextPrimaryColor}" />
    <SolidColorBrush x:Key="PortraitTextSecondaryBrush" Color="{StaticResource AetherTextSecondaryColor}" />
    <SolidColorBrush x:Key="PortraitTextMutedBrush" Color="{StaticResource AetherTextSecondaryColor}" />

    <!-- All six used to be distinct per-metric hues; now a single shared accent, same as every
         MetricCard meter fill/ring on the dashboard. -->
    <SolidColorBrush x:Key="PortraitCpuAccentBrush" Color="{StaticResource AetherAccentColor}" />
    <SolidColorBrush x:Key="PortraitGpuAccentBrush" Color="{StaticResource AetherAccentColor}" />
    <SolidColorBrush x:Key="PortraitRamAccentBrush" Color="{StaticResource AetherAccentColor}" />
    <SolidColorBrush x:Key="PortraitFpsAccentBrush" Color="{StaticResource AetherAccentColor}" />
    <SolidColorBrush x:Key="PortraitProcessAccentBrush" Color="{StaticResource AetherAccentColor}" />
    <SolidColorBrush x:Key="PortraitDriveAccentBrush" Color="{StaticResource AetherAccentColor}" />

    <SolidColorBrush x:Key="PortraitSeverityNormalBrush" Color="{StaticResource AetherTextPrimaryColor}" />
    <SolidColorBrush x:Key="PortraitSeverityWarningBrush" Color="{StaticResource AetherWarmColor}" />
    <SolidColorBrush x:Key="PortraitSeverityCriticalBrush" Color="{StaticResource AetherHotColor}" />

    <SolidColorBrush x:Key="PortraitAmdBrandBrush" Color="#ED1C24" />
    <SolidColorBrush x:Key="PortraitNvidiaBrandBrush" Color="#76B900" />
    <SolidColorBrush x:Key="PortraitIntelBrandBrush" Color="#0071C5" />

    <Style x:Key="PortraitSectionHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PortraitTextPrimaryBrush}" />
    </Style>

    <Style x:Key="PortraitCaptionLabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PortraitTextSecondaryBrush}" />
    </Style>

    <!-- CornerRadius matches the dashboard's own CardBorderStyle (12) — Padding stays tighter
         (14,12 vs. 16) since Portrait's cards sit in a narrow fixed-width column, not a wrapping grid. -->
    <Style x:Key="PortraitCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PortraitCardBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PortraitCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <!-- ButtonBase, not Button — this style is also applied to the Pin/OLED ToggleButtons, and
         Button/ToggleButton are sibling classes under ButtonBase, not parent/child, so a
         TargetType="Button" style throws at runtime when applied to a ToggleButton. -->
    <Style x:Key="PortraitHeaderIconButtonStyle" TargetType="primitives:ButtonBase">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource PortraitTextSecondaryBrush}" />
        <Setter Property="Background" Value="{StaticResource PortraitCardBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PortraitCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="15" />
    </Style>

</ResourceDictionary>
