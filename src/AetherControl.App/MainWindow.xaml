<Window
    x:Class="AetherControl.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">

    <Grid Background="{StaticResource AetherBackgroundTranslucentBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="Aether Control"
            IconSource="Assets/AppIcon.ico"
            ContextMenuMode="PopupMenu"
            LeftClickCommand="{x:Bind ShowWindowCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <!--
                    ContextMenuMode="PopupMenu" (the default, set above) renders a real native
                    Win32 popup menu via TrackPopupMenu rather than a WinUI visual flyout — per
                    H.NotifyIcon's own docs it only invokes each MenuFlyoutItem's bound Command,
                    never a XAML Click handler, since there's no actual visual element in the tree
                    to route a routed event to. Click= handlers here looked correct but silently
                    never fired; every item must bind Command instead.
                -->
                <MenuFlyout>
                    <MenuFlyoutItem Text="Open Dashboard" Command="{x:Bind OpenDashboardCommand}" />
                    <MenuFlyoutItem Text="Open Portrait Mode" Command="{x:Bind OpenPortraitModeCommand}" />
                    <MenuFlyoutItem Text="Run Optimisation" Command="{x:Bind RunOptimisationCommand}" />
                    <MenuFlyoutItem Text="RGB Control" Command="{x:Bind OpenRgbCommand}" />
                    <MenuFlyoutItem Text="Driver Check" Command="{x:Bind OpenFirmwareCommand}" />
                    <MenuFlyoutItem Text="Settings" Command="{x:Bind OpenSettingsCommand}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit" Command="{x:Bind ExitCommand}" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!--
            Custom title bar: ExtendsContentIntoTitleBar (set in code-behind) hands the strip to this
            Grid, which SetTitleBar marks as the drag region. The system still draws min/max/close
            top-right (138px reserved below). Left: icon + wordmark. Right: a compact system-health
            readout — glyph + words + numbers, so it never relies on colour alone.
        -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="Assets/Icon.png" Width="16" Height="16" Margin="16,0,0,0" VerticalAlignment="Center"
                   AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Grid.Column="1" Text="AETHER CONTROL" Margin="12,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource AppTitleTextStyle}" />

            <StackPanel x:Name="HealthIndicator" Grid.Column="3" Orientation="Horizontal" Spacing="{StaticResource Space8}"
                        VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed"
                        AutomationProperties.Name="System health" AutomationProperties.LiveSetting="Polite">
                <FontIcon x:Name="HealthGlyph" Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource StatusNormalBrush}" />
                <TextBlock x:Name="HealthStatusText" Text="Normal" Style="{StaticResource StatusTextStyle}"
                           Foreground="{StaticResource StatusNormalBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="HealthDetailText" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular" />
            </StackPanel>

            <!-- The one deliberate flourish: a thin accent fade under the title bar. -->
            <Rectangle Grid.ColumnSpan="5" Height="1" VerticalAlignment="Bottom" Opacity="0.7">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{StaticResource AetherAccentColor}" Offset="0" />
                        <GradientStop Color="Transparent" Offset="0.6" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!--
            Information architecture (ROADMAP 39.3): areas, not utilities. Every item keeps the Tag
            its page already used, so routing, tray commands and any saved state stay unchanged.
            Automation (game profiles) still lives inside Performance until its own page lands (39.5).
        -->
        <NavigationView
            x:Name="RootNavigationView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            SelectionChanged="OnNavigationSelectionChanged"
            ItemInvoked="OnNavigationItemInvoked"
            PaneDisplayMode="Left"
            OpenPaneLength="232">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="Dashboard" ToolTipService.ToolTip="Overview — live system health">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Performance" Tag="Optimisation" ToolTipService.ToolTip="Performance — optimisation, cooling, startup, game profiles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC4A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Lighting" Tag="Rgb" ToolTipService.ToolTip="Lighting — RGB devices and scenes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Devices" Tag="DevicesGroup" SelectsOnInvoked="False" ToolTipService.ToolTip="Devices — hardware inventory, firmware and drivers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F8;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="Peripherals &amp; Utilities" Tag="Devices" ToolTipService.ToolTip="Peripherals &amp; vendor utilities">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE7FC;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Firmware &amp; Drivers" Tag="Firmware" ToolTipService.ToolTip="Firmware &amp; drivers">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE9F5;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="History" ToolTipService.ToolTip="History — recorded telemetry">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <!-- A separate display experience, not a page: opens its own window. -->
                <NavigationViewItem Content="Portrait Mode" Tag="Portrait" SelectsOnInvoked="False" ToolTipService.ToolTip="Open Portrait Mode on the portrait display">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Diagnostics" Tag="Diagnostics" ToolTipService.ToolTip="Diagnostics — capability report and support bundle">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>
    </Grid>
</Window>
