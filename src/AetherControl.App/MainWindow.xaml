<Window
    x:Class="AetherControl.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">

    <Grid Background="{StaticResource AetherBackgroundTranslucentBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="Aether Control"
            IconSource="Assets/AppIcon.ico"
            ContextMenuMode="PopupMenu"
            LeftClickCommand="{x:Bind ShowWindowCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <!--
                    ContextMenuMode="PopupMenu" (the default, set above) renders a real native
                    Win32 popup menu via TrackPopupMenu rather than a WinUI visual flyout — per
                    H.NotifyIcon's own docs it only invokes each MenuFlyoutItem's bound Command,
                    never a XAML Click handler, since there's no actual visual element in the tree
                    to route a routed event to. Click= handlers here looked correct but silently
                    never fired; every item must bind Command instead.
                -->
                <MenuFlyout>
                    <MenuFlyoutItem Text="Open Dashboard" Command="{x:Bind OpenDashboardCommand}" />
                    <MenuFlyoutItem Text="Open Portrait Mode" Command="{x:Bind OpenPortraitModeCommand}" />
                    <MenuFlyoutItem Text="Run Optimisation" Command="{x:Bind RunOptimisationCommand}" />
                    <MenuFlyoutItem Text="RGB Control" Command="{x:Bind OpenRgbCommand}" />
                    <MenuFlyoutItem Text="Driver Check" Command="{x:Bind OpenFirmwareCommand}" />
                    <MenuFlyoutItem Text="Settings" Command="{x:Bind OpenSettingsCommand}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit" Command="{x:Bind ExitCommand}" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!--
            Custom title bar: ExtendsContentIntoTitleBar (set in code-behind) hands the whole
            titlebar strip to this Grid, which SetTitleBar marks as the draggable region. The
            system still draws its own min/max/close glyphs top-right; we just supply the
            branding on the left so the window reads as the app's own chrome, not default Win32.
        -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="Assets/Icon.png" Width="16" Height="16" Margin="16,0,0,0" VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="1"
                Text="Aether Control"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{StaticResource AetherTextSecondaryBrush}" />

            <!-- A thin accent-to-transparent fade under the titlebar — the one deliberate flourish
                 in an otherwise flat-charcoal chrome, echoing the colour strip Armoury Crate and
                 similar tools use to keep an all-dark window from reading as a plain Win32 shell. -->
            <Rectangle Grid.ColumnSpan="3" Height="2" VerticalAlignment="Bottom">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{StaticResource AetherAccentColor}" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <NavigationView
            x:Name="RootNavigationView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            SelectionChanged="OnNavigationSelectionChanged"
            PaneDisplayMode="Left">

            <NavigationView.MenuItems>
                <!-- Monitoring/viewing screens first, action/control tools after a separator —
                     previously one flat list of 7 items with no visual grouping at all. -->
                <NavigationViewItem Content="Dashboard" Tag="Dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Portrait Mode" Tag="Portrait">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="History">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <NavigationViewItem Content="Optimisation Centre" Tag="Optimisation">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="RGB Control" Tag="Rgb">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Firmware &amp; Drivers" Tag="Firmware">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Device Utilities" Tag="Devices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Diagnostics" Tag="Diagnostics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9CE;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>
    </Grid>
</Window>
