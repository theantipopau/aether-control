<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Single source of the app version (Settings â†’ About, update checks, exe metadata). -->
    <Version>0.9.7</Version>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AetherControl.App</RootNamespace>
    <AssemblyName>AetherControl</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- SingleInstanceFocus's [LibraryImport] P/Invokes make the interop generator emit
         unsafe code (SYSLIB1062) â€” the documented fix, not a warning suppression. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Unpackaged .exe by design â€” Aether Control ships as its own standalone executable, not an MSIX. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AetherControl.Core\AetherControl.Core.csproj" />
    <ProjectReference Include="..\AetherControl.Data\AetherControl.Data.csproj" />
    <ProjectReference Include="..\AetherControl.Services\AetherControl.Services.csproj" />
    <ProjectReference Include="..\AetherControl.Plugins.Abstractions\AetherControl.Plugins.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
