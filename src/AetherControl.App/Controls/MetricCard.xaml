<UserControl
    x:Class="AetherControl.App.Controls.MetricCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        x:Name="RootBorder"
        Style="{StaticResource CardBorderStyle}"
        Width="160"
        Padding="0"
        Translation="0,0,16">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Tone accent stripe — colour set in code from the Tone property. -->
            <Border x:Name="AccentStripe" Grid.Column="0" Background="{StaticResource AetherBorderBrush}" CornerRadius="12,0,0,12" />

            <StackPanel Grid.Column="1" Spacing="8" Padding="13,12,13,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="LabelText"
                        Grid.Column="0"
                        Foreground="{StaticResource AetherTextSecondaryBrush}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        CharacterSpacing="20"
                        TextTrimming="CharacterEllipsis" />
                    <FontIcon
                        x:Name="IconElement"
                        Grid.Column="1"
                        FontSize="13"
                        Opacity="0.5"
                        Foreground="{StaticResource AetherTextSecondaryBrush}"
                        Visibility="Collapsed" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                    <TextBlock
                        x:Name="ValueText"
                        Foreground="{StaticResource AetherTextPrimaryBrush}"
                        FontSize="26"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="UnitText"
                        Foreground="{StaticResource AetherTextSecondaryBrush}"
                        FontSize="13"
                        Margin="0,0,0,3"
                        VerticalAlignment="Bottom" />
                </StackPanel>

                <TextBlock
                    x:Name="DetailText"
                    Foreground="{StaticResource AetherTextSecondaryBrush}"
                    FontSize="11"
                    TextTrimming="CharacterEllipsis"
                    Visibility="Collapsed" />

                <Grid x:Name="MeterTrack" Height="3" CornerRadius="2" Background="{StaticResource AetherBorderBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="MeterFillColumn" Width="0*" />
                        <ColumnDefinition x:Name="MeterRemainderColumn" Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="MeterFillBar" Grid.Column="0" CornerRadius="2" Background="{StaticResource AetherAccentBrush}" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
