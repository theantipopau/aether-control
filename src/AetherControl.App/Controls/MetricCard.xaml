<UserControl
    x:Class="AetherControl.App.Controls.MetricCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AetherControl.App.Controls">

    <Border
        x:Name="RootBorder"
        Style="{StaticResource CardBorderStyle}"
        MinWidth="140"
        Padding="0"
        Translation="0,0,16">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Tone accent stripe — colour set in code from the Tone property. -->
            <Border x:Name="AccentStripe" Grid.Column="0" Background="{StaticResource AetherBorderBrush}" CornerRadius="12,0,0,12" AutomationProperties.AccessibilityView="Raw" />

            <StackPanel Grid.Column="1" Spacing="8" Padding="13,12,13,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LabelText" Grid.Column="0" Style="{StaticResource LabelTextStyle}" />
                    <!-- Optional vendor mark (e.g. a drive's brand on a Storage card) — collapses
                         when Logo is empty, same as SectionHeader's badge. -->
                    <controls:BrandLogo
                        x:Name="LogoElement"
                        Grid.Column="1"
                        Height="12"
                        MaxWidth="56"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0" />
                    <FontIcon
                        x:Name="IconElement"
                        Grid.Column="2"
                        FontSize="13"
                        Opacity="0.5"
                        Foreground="{StaticResource AetherTextSecondaryBrush}"
                        Visibility="Collapsed" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                    <!-- Tabular numerals: a reading going 9 → 10 or 1.8 → 11.2 must not shove the unit sideways. -->
                    <TextBlock
                        x:Name="ValueText"
                        Style="{StaticResource TelemetryLargeTextStyle}"
                        FontSize="26"
                        Typography.NumeralAlignment="Tabular"
                        TextTrimming="CharacterEllipsis" />
                    <!-- Severity glyph: Warm/Hot must not be communicated by colour alone. -->
                    <FontIcon
                        x:Name="SeverityIcon"
                        Glyph="&#xE7BA;"
                        FontSize="12"
                        Margin="2,0,0,6"
                        VerticalAlignment="Bottom"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="UnitText"
                        Foreground="{StaticResource AetherTextSecondaryBrush}"
                        FontSize="13"
                        Margin="0,0,0,3"
                        VerticalAlignment="Bottom" />
                </StackPanel>

                <TextBlock
                    x:Name="DetailText"
                    Foreground="{StaticResource AetherTextSecondaryBrush}"
                    FontSize="11"
                    TextTrimming="CharacterEllipsis"
                    Visibility="Collapsed" />

                <Grid x:Name="MeterTrack" Height="3" CornerRadius="2" Background="{StaticResource AetherBorderBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="MeterFillColumn" Width="0*" />
                        <ColumnDefinition x:Name="MeterRemainderColumn" Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="MeterFillBar" Grid.Column="0" CornerRadius="2" Background="{StaticResource AetherAccentBrush}" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
