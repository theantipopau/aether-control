<UserControl
    x:Class="AetherControl.App.Controls.SkeletonBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shimmer placeholder for content that has not arrived yet (first sensor poll, LHM init).
         The sweep runs from code-behind so it can size to the actual width and honour reduced motion. -->
    <Grid CornerRadius="{StaticResource RadiusCard}" Background="{StaticResource SurfaceElevatedBrush}">
        <Rectangle x:Name="Sheen" Width="120" HorizontalAlignment="Left" RadiusX="6" RadiusY="6">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Offset="0" Color="#00FFFFFF" />
                    <GradientStop Offset="0.5" Color="#14FFFFFF" />
                    <GradientStop Offset="1" Color="#00FFFFFF" />
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="SheenShift" X="-120" />
            </Rectangle.RenderTransform>
        </Rectangle>
    </Grid>
</UserControl>
