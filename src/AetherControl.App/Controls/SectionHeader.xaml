<UserControl
    x:Class="AetherControl.App.Controls.SectionHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AetherControl.App.Controls">

    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="3">
            <Rectangle Width="3" Height="13" Fill="{StaticResource AetherAccentBrush}" RadiusX="1" RadiusY="1">
                <Rectangle.RenderTransform>
                    <SkewTransform AngleX="-18" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Width="3" Height="13" Fill="{StaticResource AetherAccentBrush}" Opacity="0.45" RadiusX="1" RadiusY="1">
                <Rectangle.RenderTransform>
                    <SkewTransform AngleX="-18" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </StackPanel>
        <TextBlock x:Name="LabelText" Style="{StaticResource SectionHeaderTextStyle}" CharacterSpacing="10" />
        <!-- Optional vendor logo (BrandLogo) — collapsed when Logo is empty (unknown brand). -->
        <controls:BrandLogo x:Name="LogoElement" Height="14" MaxWidth="72" VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
