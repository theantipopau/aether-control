<UserControl
    x:Class="AetherControl.App.Controls.StatusPill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Compact dot-plus-label chip for title bars, fan pages and device lists:
         Connected / Conflict / BIOS control at a glance. State drives both dot and text
         colour from the shared tokens (never colour alone — the label always says it). -->
    <Border CornerRadius="10" Padding="10,4"
            Background="{StaticResource SurfaceElevatedBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Ellipse x:Name="Dot" Width="7" Height="7" VerticalAlignment="Center"
                     Fill="{StaticResource TextSecondaryBrush}" />
            <TextBlock x:Name="Label" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
